10 BORDER 1: PAPER 0: INK 7: CLS
20 LET S=0: LET X=15: LET V=3
30 PRINT AT 1,10;"COMET PANIC"
40 PRINT AT 3,3;"O/P: MOVER   X: SALIR"
50 PRINT AT 5,3;"PUNTOS:";S;" VIDAS:";V
60 LET Y=6: LET N=INT (RND*30)+1
70 PRINT AT 20,X;"A"
80 FOR T=6 TO 19
90 PRINT AT T,N;" "
100 LET K$=INKEY$
110 IF K$="X" OR K$="x" THEN GO TO 900
120 IF (K$="O" OR K$="o") AND X>1 THEN PRINT AT 20,X;" ": LET X=X-1
130 IF (K$="P" OR K$="p") AND X<30 THEN PRINT AT 20,X;" ": LET X=X+1
140 PRINT AT T,N;"*"
150 PAUSE 8
160 PRINT AT T,N;" "
170 NEXT T
180 IF N=X THEN LET S=S+1: BEEP .03,20
190 IF N<>X THEN LET V=V-1: BEEP .08,5
200 PRINT AT 5,3;"PUNTOS:";S;" VIDAS:";V;" "
210 IF V=0 THEN GO TO 900
220 IF S=10 THEN GO TO 800
230 GO TO 60
800 PRINT AT 12,8;"GANASTE!": BEEP .2,20: PAUSE 50: STOP
900 PRINT AT 12,8;"FIN DEL JUEGO": BEEP .2,5: STOP